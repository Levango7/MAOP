# MAOP Sandbox Environment Variables Whitelist
# 
# This file controls which environment variables are forwarded to sandboxed
# subprocesses. Set a variable to "yes" to forward it, "no" to strip it.
#
# Categories:
#   - 必需变量 (required): system runtime needs these; do NOT disable
#   - 安全变量 (safe):     do not affect security; enable as needed
#   - 业务变量 (business): MAOP_* config; enable per use-case
#
# If this file is absent, the built-in defaults in sandbox.py are used.

# ── 必需变量（不建议修改）──────────────────────────────────
PATH=yes
HOME=yes
USER=yes
SYSTEMROOT=yes
TEMP=yes
TMP=yes

# ── 安全变量 ──────────────────────────────────────────────
LANG=yes
LC_ALL=yes
LC_CTYPE=yes
TZ=yes
TMPDIR=yes
PYTHONPATH=no

# Windows-specific safe variables
COMSPEC=yes
APPDATA=yes
LOCALAPPDATA=yes
PROGRAMDATA=yes

# ── 业务变量（按需开启）──────────────────────────────────
MAOP_DASH_PORT=yes
MAOP_DASH_WORKERS=yes
MAOP_TLS_ENABLED=yes
MAOP_AUTH_ENABLED=yes
MAOP_API_KEY=no
MAOP_DB_PATH=yes