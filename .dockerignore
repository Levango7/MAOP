# MAOP Docker Ignore
# 防止敏感文件进入镜像

# Git
.git
.gitignore

# Python 缓存
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.eggs

# 虚拟环境
venv
env
.venv

# IDE
.vscode
.idea
*.swp
*.swo

# 测试和覆盖率
.pytest_cache
.coverage
htmlcov
coverage.xml

# 类型检查
.mypy_cache
.ruff_cache

# 敏感密钥文件 - 绝对不能进入镜像
**/private_key.pem
**/keys/*.pem
**/*.key
**/jwt_secret
**/.admin_initial_password
**/.admin-password

# 数据库文件
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 日志
logs/
*.log

# 数据目录（运行时生成）
# 3f335fb exception: data/migrations/*.sql are CODE assets consumed by the
# alembic 001_init/002 migrations (baked into the image at /app/seed/) —
# excluding all of data/ previously starved the container entrypoint.
data/
!data/migrations/
!data/migrations/*.sql

# 文档（不需要进入镜像）
docs/
*.md
!README.md

# 临时文件
.tmp/
*.tmp
*.bak

# 开发配置
.env
.env.local
.env.*.local

# 监控配置（通过 volume 挂载）
monitoring/
prometheus*.yml
alertmanager.yml
grafana/

# 前端源码（只需要构建产物）
# P0 fix (4d68569): the frontend-builder stage COPYs dashboard-enterprise/
# wholesale (package*.json first, then the full source for `npm run build`).
# Excluding src/ here broke that COPY. Only node_modules stays excluded —
# npm ci reinstalls it inside the stage from the lockfile.
dashboard-enterprise/node_modules

# 归档
archive/

# P3-D-07 fix: exclude non-runtime files/dirs from build context to reduce
# docker build transfer size and layer cache invalidation probability.
# These are not needed inside the runtime image.

# CI/CD config
.github/

# Build/dev scripts (not needed at runtime — entrypoint is copied explicitly)
scripts/
tools/
deliverables/
Makefile
start.sh
maop.ps1

# Python test + dev files (not needed at runtime)
py/tests/
py/scripts/
py/.cov_baseline.json
# P0 fix (4d68569): requirements.lock was excluded here but the builder stage
# COPYs it (py/requirements.lock) to pip-install the pinned, audited deps —
# the exclusion broke the first-ever real docker build. requirements.txt is
# likewise kept: it documents the loose dependency set and is small.
# py/requirements.lock
# py/requirements.txt

# Templates (the rendered alembic.ini is copied explicitly)
alembic.ini.template

# Top-level docs (already covered by docs/ + *.md above, but explicit for clarity)
CHANGELOG.md
LICENSE
SECURITY.md
CONTRIBUTING.md
ROADMAP.md

# Audit reports
docs/p23-cideploy-audit.md
cc_baseline.json
_run_check.py
