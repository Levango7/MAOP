{
  "name": "maop-dashboard-enterprise",
  "version": "5.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src/ --ext .js,.vue",
    "lint:fix": "eslint src/ --ext .js,.vue --fix",
    "typecheck": "vue-tsc --noEmit",
    "design:contrast": "python scripts/wcag.py --self-test && python scripts/wcag.py --tokens src/styles/tokens.css --tokens src/styles/themes.css --pairs design/contrast-pairs.txt --pairs-only --min-pairs 164",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "pinia": "^4.1.0",
    "vis-data": "^8.0.6",
    "vis-network": "^10.1.4",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "vite": "^8.3.6",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.14"
  }
}
