# MAOP Environment Configuration
# Copy to .env and customize
#
# This is the single source of truth for env var examples.
# (py/.env.example has been merged here and removed.)

# ── Core ───────────────────────────────────────────────────────
MAOP_ENV=production
MAOP_PROJECT_NAME=MAOP
# DEPRECATED (v5.0.0): use MAOP_DASH_PORT instead. MAOP_PORT is not directly
# read by code; it is kept only as a documentation alias for MAOP_DASH_PORT.
# Will be removed in v6.0.0.
MAOP_PORT=9079
# Canonical dashboard listen port (read by server.py and Dockerfile).
MAOP_DASH_PORT=9079
MAOP_ROOT=/app
MAOP_ROOT_DIR=
MAOP_DEBUG=0
MAOP_LOG_LEVEL=INFO
# 默认 agent：config 路由未匹配时的兜底（未设置回退 codex，需已在 agents.yaml 中定义）。
MAOP_DEFAULT_AGENT=codex
# Chat 面板默认 agent / model。agent 默认 "MAOP"（自引用）；model 留空由 provider 决定。
MAOP_LLM_DEFAULT_AGENT=MAOP
MAOP_LLM_DEFAULT_MODEL=

# ── Security ───────────────────────────────────────────────────
# DEPRECATED (v5.0.0): use MAOP_AUTH_ENABLED instead. Short name still works
# but emits a DeprecationWarning. Will be removed in v6.0.0.
MAOP_AUTH=1
# Canonical auth enable flag (pydantic MAOPSettings reads this first via AliasChoices).
MAOP_AUTH_ENABLED=1
# When auth is disabled (MAOP_AUTH=0), anonymous users receive the "read"
# role by default. Set MAOP_AUTH_DISABLED_ADMIN=1 to opt back into admin
# role for local dev tools that need write access.
MAOP_AUTH_DISABLED_ADMIN=0
MAOP_AUTH_DB_PATH=
# JWT signing secret. REQUIRED in production (MAOP_ENV=production).
# - Leave empty in non-production: auth.py auto-generates a 64-char random
#   secret and persists to data/jwt_secret (mode 0o600).
# - In production: set to a cryptographically random string of >=32 chars.
#   Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# - Weak/short values (e.g. "secret", "changeme", <32 chars) are rejected
#   at startup by _validate_jwt_secret_strength().
# 生产环境必须修改：留空虽会随机生成但每次重启失效，生产须固定 >=32 位随机密钥
# （生成：python -c "import secrets;print(secrets.token_hex(32))"）。
MAOP_JWT_SECRET=
# Initial admin password for the dashboard. Leave empty to auto-generate
# a random password (saved to data/.admin-password on first run).
# 生产环境必须修改：部署后务必改设 >=16 位随机强密码
# （生成：python -c "import secrets;print(secrets.token_urlsafe(16))"）。
MAOP_ADMIN_PASSWORD=
# H7 fix: Docker secrets 标准支持。设置后 auth.py 从文件读取管理员密码，
# 优先级高于 MAOP_ADMIN_PASSWORD。生产环境推荐使用此方式。
# 示例：MAOP_ADMIN_PASSWORD_FILE=/run/secrets/maop_admin_password
MAOP_ADMIN_PASSWORD_FILE=
# API key vault master key (Fernet). Provide either MAOP_KEY (raw key value)
# or MAOP_KEY_FILE (path to key file). If both empty, auto-generates and
# persists to data/.api-key. Required in production for API key encrypt/decrypt.
# See py/maop/core/api_key_vault.py for key format (32-byte base64 / 44-char Fernet).
MAOP_KEY=
MAOP_KEY_FILE=
# DEPRECATED (v5.0.0): use MAOP_TLS_ENABLED instead. Short name still works
# (read by server.py for TLS termination toggle) but emits a DeprecationWarning.
# Will be removed in v6.0.0.
MAOP_TLS=0
MAOP_TLS_ENABLED=0
# When MAOP_TLS=1 (direct TLS termination in uvicorn, single-worker only):
# Both short (MAOP_TLS_CERT/MAOP_TLS_KEY) and long
# (MAOP_TLS_CERT_FILE/MAOP_TLS_KEY_FILE) names are accepted.
MAOP_TLS_CERT=
MAOP_TLS_KEY=
MAOP_TLS_CERT_FILE=
MAOP_TLS_KEY_FILE=
MAOP_TLS_MIN_VERSION=TLSv1_2
# Allow deprecated/insecure TLS versions (TLSv1, TLSv1_1). Default 0 (fail-closed).
# Set to 1 ONLY for legacy integration debugging — emits a warning. See core/tls.py.
MAOP_TLS_ALLOW_DEPRECATED=0
# For production TLS termination, use the nginx profile instead:
#   docker compose --profile tls up -d
# H9 fix: 生产 nginx TLS 证书目录配置（bind mount）。
# 原：使用 named volume 挂载证书目录，首次挂载为空卷导致证书缺失。
# 现：要求宿主机目录存在并包含证书文件，缺失时 compose 启动报错。
MAOP_TLS_CERT_DIR=./certs/nginx
# 证书文件名（位于 MAOP_TLS_CERT_DIR 内），默认 fullchain.pem / privkey.pem（Let's Encrypt 风格）。
MAOP_TLS_CERT_FILENAME=fullchain.pem
MAOP_TLS_KEY_FILENAME=privkey.pem
# Place certs in ./certs/ and configure nginx.conf
# JWT 有效期（秒）。默认 7200（2 小时）。
MAOP_JWT_TTL_S=7200
# 生产环境是否暴露 API 文档（Swagger / ReDoc / OpenAPI）。默认 0 = 隐藏（fail-closed）；
# 非生产环境默认开启。只有显式设 1 才在 production 暴露。
MAOP_EXPOSE_DOCS=0
# Vault 不可用时是否允许降级到本地加密 vault。默认 0 = 直接 RuntimeError（fail-fast）；
# 只有显式设 1 才降级（降级意味着密钥存储面缩小，需自行评估）。
MAOP_SECRET_ALLOW_FALLBACK=0
# API Key 限流窗口（秒）。默认 60。
MAOP_APIKEY_RATE_WINDOW_S=60

# ── Verification Gates ─────────────────────────────────────────
# 强制 deploy/pipeline/fileops 路由声明 dry-run（plan.dry_run=True），使
# maop_verify 的 "dry-run" gate 真正校验执行结果自报的 dry-run 信号。
# 默认 0/未设：与历史行为一致——gate 挂载但对未声明的 plan 恒 PASS（no-op）。
# ⚠️ fail-closed：当前执行器**不产出** dry-run 信号（stdout "DRY-RUN" 标记或
#    structured_output.dry_run），开启后这三条路由的任务会卡在 verify 阶段失败。
#    先接执行器信号产出，再启用本开关。
# 注：config/agents.yaml 路由表无 "deploy" 键——真实任务只命中 pipeline/fileops，
#    deploy 分支仅能经 routing_key 覆盖触达。
MAOP_DRY_RUN_ENFORCE=0

# ── Logging ────────────────────────────────────────────────────
# Emit JSON-structured logs (for ELK / Loki / CloudWatch). Set to 1 in
# container environments; leave 0 for local dev (plain-text logs).
MAOP_JSON_LOG=1

# ── Monitoring ─────────────────────────────────────────────────
MAOP_OTEL_ENABLED=0
# MAOP_OTEL_EXPORTER is defined in the "OpenTelemetry" section below (otlp).
MAOP_METRICS_ENABLED=1
MAOP_METRICS_PATH=/api/metrics

# ── Database / Vault Secrets (docker-compose profiles) ────────
# Required when using --profile postgres (docker-compose.yml uses :? syntax
# and refuses to start without it). The example value "maop_dev" is for
# LOCAL DEVELOPMENT ONLY — never use it outside your machine.
# 生产环境必须修改：禁止使用 maop_dev 弱口令，应使用 >=16 位随机密码。
MAOP_PG_PASSWORD=maop_dev
# Required when using --profile vault (MAOP_SECRET_BACKEND=vault).
# Use "dev-token" with the official Vault dev image for local testing.
MAOP_VAULT_TOKEN=dev-token

# ── Data ──────────────────────────────────────────────────────
MAOP_DATA_DIR=
MAOP_DB_PATH=
MAOP_MEMORY_DB_PATH=
# 数据库后端：sqlite（默认）| postgresql。
# 连接串用 MAOP_DATABASE_URL（推荐）或 MAOP_DB_URL（legacy）覆盖；
# 只有显式设成 postgresql 才会切库，缺省仍是 sqlite（见 core/backends/db_utils.py）。
MAOP_DB_BACKEND=sqlite
# 迁移工具读取的 SQLite 源库 URL（sqlite_to_pg / vector_migration 用）。留空则用默认路径。
MAOP_SQLITE_URL=
# 破坏性迁移的显式确认开关：默认 0 = 拒绝执行。
# 迁移脚本要求设成 1 才允许 drop/重建一类操作（见 migrations/pg/versions/001、002）。
MAOP_MIGRATION_DESTRUCTIVE=0
# 允许的备份目录白名单（多个目录用系统路径分隔符分隔：Windows 用 ';'，POSIX 用 ':'）。
# 留空则只允许 <root>/data/backups。
MAOP_BACKUP_DIR=

# ── Memory ────────────────────────────────────────────────────
MAOP_MEMORY_PRUNE_TTL_DAYS=90
MAOP_MEMORY_PRUNE_ON_STARTUP=0
# working cache 的 LRU 上限（条）。默认 1000；非数字时回退默认值并告警。
MAOP_WORKING_CACHE_MAX_SIZE=1000

# ── Circuit Breaker ───────────────────────────────────────────
MAOP_CB_FAILURE_THRESHOLD=5
MAOP_CB_RECOVERY_TIMEOUT_S=30

# ── Budget / Cost ─────────────────────────────────────────────
# 成本预算限额与告警阈值（USD）。0 = 无限额（默认，本地工具不强制预算）。
# 也可在 Dashboard「成本追踪」页运行时配置（无需重启）。
MAOP_BUDGET_DAILY_LIMIT_USD=0
MAOP_BUDGET_MONTHLY_LIMIT_USD=0
MAOP_BUDGET_ALERT_THRESHOLD=0.8
# 个人版累计成本上限（USD，0=不限额）。达到阈值触发熔断（默认软熔断：拒绝新调用，运行中任务跑完）。
MAOP_PERSONAL_COST_CAP=0
# 硬熔断开关：1=达到阈值时连运行中任务一起中断；0（默认）=软熔断。
MAOP_PERSONAL_COST_HARD=0

# ── Worker Pool ───────────────────────────────────────────────
MAOP_WORKER_COUNT=4

# ── Background Tasks ──────────────────────────────────────────
# Enable per-worker background tasks (backup, log-rotate, WS push).
# Auto-disabled when MAOP_DASH_WORKERS > 1 to avoid duplicates.
# Override with MAOP_BACKGROUND_TASKS=1 to force-enable for a dedicated worker.
MAOP_BACKGROUND_TASKS=1

# ── Docker Compose ─────────────────────────────────────────────
# 生产环境必须修改：替换为 >=16 位随机强密码（生成：python -c "import secrets;print(secrets.token_urlsafe(16))"）。
GRAFANA_PASSWORD=change-me-in-production
# ── Backends (profiles: redis/postgres/vault) ─────────────────
# Cache/Queue/HA backend selection. Defaults to "memory" (single-node).
MAOP_CACHE_BACKEND=memory
MAOP_QUEUE_BACKEND=memory
# MAOP_HA_BACKEND：企业版专属配置（高可用后端，如 redis/etcd）。
# 个人版默认 memory（单节点），企业版通过 maop-enterprise 包启用分布式 HA。
# 详见 docs/adr/015-distributed-ha-redis-lease.md
MAOP_HA_BACKEND=memory
# Redis connection (when *_BACKEND=redis)
MAOP_REDIS_HOST=redis
MAOP_REDIS_PORT=6379
# Required when using --profile redis: docker-compose.yml passes it to
# `redis-server --requirepass` via :? syntax and refuses to start without it.
# 留空仅适用于未启用 Redis profile 的本地开发；启用后必须设置为强密码。
# 生产环境必须修改：设置 Redis 强密码（>=16 位随机），禁止使用弱口令。
MAOP_REDIS_PASSWORD=
MAOP_REDIS_DB=0

# ── PostgreSQL (profile: postgres) ────────────────────────────
MAOP_PG_HOST=postgres
MAOP_PG_PORT=5432
MAOP_PG_DATABASE=maop
MAOP_PG_USER=maop

# ── Vault (profile: vault, MAOP_SECRET_BACKEND=vault) ─────────
MAOP_VAULT_ADDR=http://vault:8200
MAOP_VAULT_MOUNT=secret
MAOP_VAULT_PATH=maop

# ── OpenTelemetry ─────────────────────────────────────────────
MAOP_OTEL_ENDPOINT=http://otel-collector:4317
MAOP_OTEL_SERVICE_NAME=maop-dashboard
MAOP_OTEL_EXPORTER=otlp

# ── MCP Security ──────────────────────────────────────────────
# Strict command whitelist for MCP stdio transport. MUST be 1 in production.
# Set to 0 only for local dev (NOT for production — disables RCE protection).
MAOP_MCP_STRICT_COMMAND_WHITELIST=1
# Strict plugin checksum verification. Default 1 (fail-closed): plugins with
# mismatched/missing checksums are rejected. Set to 0 ONLY for local dev.
# See py/maop/core/plugin.py.
MAOP_PLUGIN_STRICT_CHECKSUM=1
# 沙箱环境变量白名单文件（marketplace 插件执行用）。默认读项目根 .env.sandbox；
# 每行 KEY=yes / KEY=no，仅 yes 的变量会被转发，其余一律剥离。文件缺失时用内置安全集。
MAOP_SANDBOX_ENV_FILE=

# ── Dashboard ─────────────────────────────────────────────────
# 监听地址。安全默认 127.0.0.1（仅本机访问）。
# 容器部署必须设为 0.0.0.0 才能从容器外访问——Dockerfile 与
# docker-compose(.prod).yml 均已内置该值，本地裸机运行无需设置。
# 需要局域网/外部访问时显式改为 0.0.0.0 并配合防火墙/反代使用。
MAOP_DASH_HOST=127.0.0.1
MAOP_DASH_PORT=9079
MAOP_DASH_WORKERS=1

# ── Rate Limiting ─────────────────────────────────────────────
MAOP_RATE_LIMIT_ENABLED=1
MAOP_RATE_LIMIT_RPS=30
MAOP_RATE_LIMIT_BURST=60
# Trust X-Forwarded-For header for client IP extraction behind a reverse
# proxy (nginx). Default 0 (do not trust) to prevent IP spoofing.
# Set to 1 when running behind nginx with proxy_set_header X-Forwarded-For.
MAOP_TRUST_PROXY=0

# ── CORS ──────────────────────────────────────────────────────
MAOP_CORS_ORIGINS=http://localhost:9079,http://127.0.0.1:9079


# ── OmniRoute (local AI gateway) ──────────────────────────────
# OmniRoute is a local AI gateway supporting 160+ providers with
# auto failover. When running locally (http://localhost:20128),
# no API key is needed - set to "dummy" or any non-empty value.
# 生产环境必须修改：dummy 仅本地网关免鉴权使用；接入远程 OmniRoute 须替换为真实密钥。
OMNIROUTE_API_KEY=dummy
# When OmniRoute is the default LLM exit (default_provider: omniroute in
# models.yaml), this key is required. Set to "dummy" for local gateway
# which doesn't require authentication.

# ── Enterprise License ────────────────────────────────────────
# Required for MAOP Enterprise edition in production. Obtain a
# license key from the MAOP commercial team. Without a key, the
# system runs in honor-system mode (enterprise package importable
# = enterprise) with a warning. With an invalid key, edition
# degrades to Personal.
#
# To generate a development/test license:
#   python scripts/generate_license.py --customer "Test" --expires 2027-12-31
#
# Or save to data/license.key file (alternative to env var).
MAOP_LICENSE_KEY=
# 签发 license 用的 Ed25519 私钥路径（**仅签发侧**，生产环境必须指向真实的离线私钥）。
# 不设时使用进程内自动生成的临时 keypair —— 只适合本地自测，重启即失效。
MAOP_LICENSE_MGR_PRIVATE_KEY=

# ── n8n Integration (Enterprise only) ──────────────────────────
# Enable with: docker compose --profile n8n up -d
# n8n provides external trigger + SaaS integration layer for MAOP.
# Webhook URL for n8n to call MAOP: http://dashboard:9079/api/n8n/webhook
N8N_BASE_URL=http://localhost:5678
N8N_USER=admin
# 生产环境必须修改：替换为 >=16 位随机强密码。
N8N_PASSWORD=change-me-in-production
# 生产环境必须修改：必须设置随机强密钥（>=32 位），禁止使用空值。
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ── AlertManager Receivers (production monitoring) ─────────────
# Enable with: docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile monitoring up -d
# AlertManager renders alertmanager.yml with these env vars at startup
# (via alertmanager/render-config.sh). All credentials must come from
# env vars or Vault — never hardcoded in alertmanager.yml.
#
# ── Webhook receiver (default, recommended) ───────────────────
# MAOP dashboard webhook endpoint. Override for external systems
# (PagerDuty, n8n, custom integration).
WEBHOOK_URL=http://maop-app:9079/api/alerts/webhook
#
# ── Email receiver (critical alerts) ──────────────────────────
# Configure SMTP to enable email alerts for critical severity.
# Leave SMTP_PASSWORD empty to disable email auth (e.g. local relay).
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=alertmanager@example.com
SMTP_HOST=localhost:587
SMTP_USER=
# 生产环境必须修改：SMTP 鉴权凭据必须设置随机强密码/密钥，禁止使用空值。
SMTP_PASSWORD=
SMTP_AUTH_SECRET=
SMTP_AUTH_IDENTITY=
#
# ── Slack receiver (optional) ─────────────────────────────────
# Leave SLACK_WEBHOOK_URL empty to disable slack.
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts

# ── Edition & Backends ────────────────────────────────────────
# MAOP_EDITION: personal | enterprise | auto (auto-detect by license)
MAOP_EDITION=auto
# Backend selection (enterprise edition)
MAOP_STORAGE_BACKEND=sqlite
# MAOP_CACHE_BACKEND and MAOP_QUEUE_BACKEND are defined in the
# "Backends (profiles: redis/postgres/vault)" section above (memory).
MAOP_KV_BACKEND=memory
MAOP_SECRET_BACKEND=local
# Allow fallback to SQLite/memory when enterprise backend unavailable
MAOP_STORAGE_ALLOW_FALLBACK=0
MAOP_CACHE_ALLOW_FALLBACK=0
MAOP_QUEUE_ALLOW_FALLBACK=0
MAOP_KV_ALLOW_FALLBACK=0

# ── Backend Connection Strings ────────────────────────────────
MAOP_REDIS_URL=
MAOP_RABBITMQ_URL=
MAOP_PG_DSN=

MAOP_DATABASE_URL=
# SQLAlchemy URL override for Alembic migrations (py/maop/migrations/alembic/env.py).
# If empty, defaults to sqlite:///<MAOP_ROOT>/data/maop.db. Set when running
# migrations against PostgreSQL/external DB.
MAOP_DB_URL=
MAOP_MIGRATION_BACKEND=sqlite

# ── SSO / SAML (Enterprise only) ──────────────────────────────
MAOP_SSO_PROVIDER=
MAOP_SSO_CLIENT_ID=
# 生产环境必须修改：SSO 客户端密钥必须 >=32 位随机（secrets.token_hex(32)），禁止使用空值。
MAOP_SSO_CLIENT_SECRET=
MAOP_SSO_AUTHORIZE_URL=
MAOP_SSO_TOKEN_URL=
MAOP_SSO_USERINFO_URL=
MAOP_SSO_REDIRECT_URI=
MAOP_SSO_SCOPES=

# ── CSP Security ──────────────────────────────────────────────
MAOP_CSP=
MAOP_CSP_REPORT_ONLY=0
MAOP_CSP_REPORT_URI=
MAOP_CSP_CONNECT_SRC=

# ── CRL / License Revocation ──────────────────────────────────
MAOP_CRL_URL=
MAOP_CRL_CACHE_TTL_S=86400
# 严格模式：CRL 不可达 / 缓存过期 / 无签名 CRL 时拒绝 license（fail-closed）。
# 默认 0（宽松）：上述情况仅记 WARNING 后放行。高敏感部署请设 1。
MAOP_CRL_STRICT=0
MAOP_CRL_MAX_CACHE_AGE_S=604800

# ── Enterprise Quota ──────────────────────────────────────────
# 企业版配额中间件开关。默认 1（启用）。设为 0 会完全关闭配额强制
# （配额检查不再生效），生产环境请勿设为 0。
MAOP_QUOTA_MIDDLEWARE=1

# ── etcd (Enterprise KV backend) ──────────────────────────────
MAOP_ETCD_HOST=
MAOP_ETCD_PORT=2379
MAOP_ETCD_NAMESPACE=maop
# P0 安全修复：etcd 认证凭证。生产环境必须启用：
#   1. 在 etcd 服务端创建 root 用户并开启认证：
#      etcdctl user add root && ETCDCTL_API=3 etcdctl auth enable
#   2. 为应用创建普通用户并授权（role + user grant-role）
#   3. 在此填写用户名/密码 —— 两者必须成对提供，只设其一会拒绝连接。
# 本地开发未启用 etcd auth 时留空即可。
# 生产环境必须修改：禁止匿名访问，使用 >=16 位随机密码。
MAOP_ETCD_USERNAME=
MAOP_ETCD_PASSWORD=
# TLS / mTLS 证书路径（生产建议启用，路径挂载进容器后填写）。
# MAOP_ETCD_CA_CERT 指向 CA 证书；CERT_KEY/CERT_CERT 为客户端 mTLS 密钥对。
MAOP_ETCD_CA_CERT=
MAOP_ETCD_CERT_KEY=
MAOP_ETCD_CERT_CERT=

# ── Evolution / Self-Improvement (v5.2.0) ─────────────────────
# 自演化闭环总开关。默认空 = 关闭。设为 1/true/yes/on 启用。
# 开启后主循环的 evolve 阶段会跑一轮演化 cycle（观察→建议→审批→应用→可回滚）。
MAOP_EVOLUTION_LOOP_ENABLED=
# 演化 cycle 是否只预览不落地。默认 true（向后兼容、安全默认）；
# 设 0/false/no 才真正执行 APPLY。
MAOP_EVOLUTION_DRY_RUN=true
# 是否允许用 LLM 生成 agent 改进建议（默认关闭 = 零行为变更；规则引擎建议不受影响）。
MAOP_EVOLVE_LLM_SUGGEST=
# A/B 实验名：指定时演化取该实验，留空则取最新创建的实验。
MAOP_AB_EXPERIMENT=

# ── Runtime Tuning ────────────────────────────────────────────
MAOP_DB_PER_MODULE=0
MAOP_SQLITE_BUSY_TIMEOUT_MS=10000
MAOP_AUTO_SCHED=0
MAOP_BACKUP_INTERVAL=3600
# H10 fix: S3 off-box 备份配置。设置 MAOP_BACKUP_S3_BUCKET 后启用 S3 上传。
# 备份完成后上传到 S3 并校验远程对象存在性，满足 off-box 备份要求。
# 需安装 boto3：pip install boto3
MAOP_BACKUP_S3_BUCKET=
MAOP_BACKUP_S3_PREFIX=backups/
MAOP_BACKUP_S3_REGION=
MAOP_BACKUP_S3_ENDPOINT=
# 上传 S3 后是否保留本地副本（1=保留，0=删除，默认 0）
MAOP_BACKUP_KEEP_LOCAL=0
MAOP_LOGROTATE_INTERVAL=3600
MAOP_METRIC_MAX_CARDINALITY=1000
# DEPRECATED (v5.0.0): use MAOP_DASH_WORKERS instead. Short name is read as
# fallback when MAOP_DASH_WORKERS is unset. Will be removed in v6.0.0.
MAOP_WORKERS=4
MAOP_RATE_LIMIT=
MAOP_JSON_LOG_FILE=
# 统一超时配置（秒）—— 由 MAOPSettings 提供，改动无需碰代码。
MAOP_SUBPROCESS_TIMEOUT_S=10
MAOP_HTTP_TIMEOUT_S=30
MAOP_UPGRADE_TIMEOUT_S=120
MAOP_TASK_WAIT_TIMEOUT_S=300
# 派发并发上限与重试（MAOPSettings）。
MAOP_DISPATCH_CONCURRENCY=10
MAOP_DISPATCH_RETRY_MAX=3
MAOP_DISPATCH_RETRY_BASE_MS=500
# 外部服务 API key（MAOPSettings.api_key，默认空）。
MAOP_API_KEY=
MAOP_JWT_ALLOW_EPHEMERAL=1
MAOP_HOOK_FAIL_MODE=raise
MAOP_ALLOW_DESTRUCTIVE_DOWNGRADE=0
DOC_PIPELINE_ROOT=
# 同上，规范名（MAOPSettings.doc_pipeline_root 的 MAOP_ 前缀映射；两者都读到同一个字段）。
MAOP_DOC_PIPELINE_ROOT=
