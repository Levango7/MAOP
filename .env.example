# MAOP Environment Configuration
# Copy to .env and customize

# ── Core ───────────────────────────────────────────────────────
MAOP_ENV=production
MAOP_PORT=9079
MAOP_ROOT=/app

# ── Security ───────────────────────────────────────────────────
MAOP_AUTH=1
MAOP_JWT_SECRET=change-me-to-a-random-string
MAOP_TLS=0

# ── Logging ────────────────────────────────────────────────────
MAOP_JSON_LOG=1
MAOP_LOG_LEVEL=INFO

# ── Monitoring ─────────────────────────────────────────────────
MAOP_OTEL_ENABLED=0
MAOP_OTEL_EXPORTER=none

# ── Docker Compose ─────────────────────────────────────────────
GRAFANA_PASSWORD=admin