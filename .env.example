# MAOP Environment Variables — Copy to .env and customize
# See docker-compose.yml for usage

# ── Dashboard ───────────────────────────────────────────────────
MAOP_DASH_PORT=9079
MAOP_DASH_WORKERS=1
MAOP_LOG_LEVEL=INFO
MAOP_AUTH_ENABLED=0
MAOP_RATE_LIMIT_RPS=30
MAOP_RATE_LIMIT_BURST=60
MAOP_CORS_ORIGINS=http://localhost:9079

# ── TLS ─────────────────────────────────────────────────────────
MAOP_TLS=0
MAOP_TLS_CERT=
MAOP_TLS_KEY=

# ── Backend Selection ───────────────────────────────────────────
# Options: sqlite, local (same as sqlite for storage)
MAOP_BACKEND_STORAGE=sqlite
MAOP_BACKEND_CACHE=local
MAOP_BACKEND_QUEUE=local
MAOP_BACKEND_KV=local
MAOP_BACKEND_SECRET=local

# ── OpenTelemetry ───────────────────────────────────────────────
MAOP_OTEL_ENABLED=0
MAOP_OTEL_EXPORTER=otlp
MAOP_OTEL_ENDPOINT=http://localhost:4317
MAOP_OTEL_SERVICE_NAME=maop-dashboard