# MAOP Environment Configuration Template
# Copy to .env and adjust values for your deployment.

# ── Core ───────────────────────────────────────────────────
MAOP_PROJECT_NAME=MAOP
MAOP_ROOT_DIR=
MAOP_DEBUG=0
MAOP_LOG_LEVEL=INFO

# ── Dashboard ──────────────────────────────────────────────
MAOP_DASH_HOST=127.0.0.1
MAOP_DASH_PORT=9079
MAOP_DASH_WORKERS=1

# ── TLS ────────────────────────────────────────────────────
MAOP_TLS_ENABLED=0
MAOP_TLS_CERT_FILE=
MAOP_TLS_KEY_FILE=
MAOP_TLS_MIN_VERSION=TLSv1_2

# ── Auth ───────────────────────────────────────────────────
MAOP_AUTH_ENABLED=0
MAOP_AUTH_DB_PATH=
# JWT signing secret (HMAC-SHA256). Leave empty to auto-generate
# and persist to data/jwt_secret on first run.
# Priority: 1) this env var  2) data/jwt_secret file  3) auto-generate
MAOP_JWT_SECRET=
# Initial admin password for the dashboard. Leave empty to auto-generate
# a random password (saved to data/.admin-password on first run).
MAOP_ADMIN_PASSWORD=

# ── Rate Limit ─────────────────────────────────────────────
MAOP_RATE_LIMIT_ENABLED=1
MAOP_RATE_LIMIT_RPS=30
MAOP_RATE_LIMIT_BURST=60

# ── CORS ───────────────────────────────────────────────────
MAOP_CORS_ORIGINS=http://localhost:9079,http://127.0.0.1:9079

# ── Data ───────────────────────────────────────────────────
MAOP_DATA_DIR=
MAOP_DB_PATH=
MAOP_MEMORY_DB_PATH=

# ── Memory ─────────────────────────────────────────────────
MAOP_MEMORY_PRUNE_TTL_DAYS=90
MAOP_MEMORY_PRUNE_ON_STARTUP=0

# ── Circuit Breaker ────────────────────────────────────────
MAOP_CB_FAILURE_THRESHOLD=5
MAOP_CB_RECOVERY_TIMEOUT_S=30

# ── Worker Pool ────────────────────────────────────────────
MAOP_WORKER_COUNT=4

# ── Monitoring ─────────────────────────────────────────────
MAOP_METRICS_ENABLED=1
MAOP_METRICS_PATH=/api/metrics
